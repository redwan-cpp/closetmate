# ─────────────────────────────────────────────
#  ClosetMate AI Backend — Environment Variables
#  Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production (>= 32 random chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every user out. Locally you can leave it unset.
# JWT_SECRET=

# "dev" | "prod". On Cloud Run this is detected automatically (prod); locally it
# defaults to dev, which exposes /docs and error details and uses lenient quotas.
# ENV=dev

# ── AI models (change here when a provider retires a model) ──────────────────
# Run `python scripts/check_models.py` to confirm these IDs are still live.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_VISION_DETAIL=high          # low|high|auto — "low" is far cheaper; A/B before switching
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# ── Free-plan monthly limits per user (production defaults shown) ────────────
# QUOTA_FREE_CHAT_MONTHLY=60
# QUOTA_FREE_VISION_MONTHLY=40
# QUOTA_FREE_BGREMOVE_MONTHLY=80
# QUOTA_FREE_INSIGHTS_MONTHLY=4

# ── Closet photos ────────────────────────────────────────────────────────────
# REQUIRED in production: a PRIVATE Cloud Storage bucket (see DEPLOY.md §2).
# Locally, leave it unset: photos are kept in ./photo_store/ (git-ignored).
# GCS_BUCKET=
# Per-user storage caps and how long a photo link stays valid (defaults shown).
# MAX_PHOTOS_PER_USER=600            # default: closet size + 100
# MAX_PHOTO_BYTES_PER_USER=262144000 # 250 MiB
# PHOTO_URL_TTL_SECONDS=21600        # 6 hours

# Comma-separated browser origins allowed by CORS (the mobile app does not need this).
# CORS_ORIGINS=https://app.example.com

# Base URL of this backend server (used to build image URLs for chat responses)
# Set to your machine's local IP when testing on a physical device, e.g.:
# BASE_URL=http://192.168.0.188:8000
BASE_URL=http://localhost:8000

# Database connection string.
# Leave unset locally — the app will use SQLite (closetmate.db) automatically.
# For Heroku Postgres, set this to your Heroku DATABASE_URL value, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=
