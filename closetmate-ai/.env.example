# ─────────────────────────────────────────────
#  ClosetMate AI Backend — Environment Variables
#  Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL of this backend server (used to build image URLs for chat responses)
# Set to your machine's local IP when testing on a physical device, e.g.:
# BASE_URL=http://192.168.0.188:8000
BASE_URL=http://localhost:8000
